{
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "嗅探猫 Dev - Projector",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "description": "嗅探猫 Dev / Cat Catch Dev with Global SidePanel Projector + Floating Projector Button",
  "icons": {
    "64": "/img/icon.png",
    "128": "/img/icon128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "嗅探猫 Dev - Projector",
  "short_name": "猫抓Dev",
  "homepage_url": "https://github.com/xifangczy/cat-catch",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {},
    "enable": {
      "description": "__MSG_pause__ / __MSG_enable__"
    },
    "auto_down": {
      "description": "__MSG_autoDownload__"
    },
    "catch": {
      "description": "__MSG_cacheCapture__"
    },
    "m3u8": {
      "description": "__MSG_m3u8Parser__"
    },
    "clear": {
      "description": "__MSG_clear__"
    },
    "reboot": {
      "description": "__MSG_restartExtension__"
    },
    "deepSearch": {
      "description": "__MSG_deepSearch__"
    },
    "preview": {
      "description": "__MSG_preview__"
    }
  },
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/content-script.js",
        "js/projector-float.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "default_locale": "en",
  "version": "2.7.2.1",
  "version_name": "2.7.2-dev-projector-v11",
  "incognito": "split"
}